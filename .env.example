# Firebase Configuration
# Get these values from https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# AI Proxy / HuggingFace fallback (optional)
# Set to true only if you want strict rejection of low-quality HF answers.
HF_STRICT_VALIDATION=false

# OpenRouter (restricted to allowed free model list, tries all configured candidates)
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=qwen/qwen3.6-plus:free,nousresearch/hermes-3-llama-3.1-405b:free,qwen/qwen3-next-80b-a3b-instruct:free

# Routeway fallback provider (after OpenRouter)
ROUTEWAY_API_KEY=
ROUTEWAY_BASE_URL=https://api.routeway.ai/v1
ROUTEWAY_MODEL=step-3.5-flash:free

# Gemini validation (optional)
GEMINI_STRICT_VALIDATION=false
